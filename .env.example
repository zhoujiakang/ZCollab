# 宿主机对外端口。默认 8080，浏览器访问 http://localhost:8080
# 本机 8080 被开发实例占用时，复制本文件为 .env 并改这里
WEB_PORT=8080

# 数据库密码。默认 zcollab，与 docker-compose.yml 里的默认值一致。
# 注意：只在数据卷第一次初始化时生效，必须在第一次 up 之前改。
POSTGRES_PASSWORD=zcollab

# WebSocket 允许的浏览器来源，多个地址用逗号分隔，不带末尾斜杠。
# 用域名访问时加入完整来源，例如 https://docs.zzzink.cn。
COLLAB_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*
